# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and the only record of what the
# dashboard needs. `.env*` above is Next's default and swallowed it, so the file
# existed on disk, was edited, and was never in the repo — a clone got no
# dashboard configuration at all.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
