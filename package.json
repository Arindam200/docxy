{
  "name": "docxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multi-agent documentation-and-changelog pipeline built on the TrueForge agent harness.",
  "bin": {
    "docxy": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "docxy": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "test": "tsx test/selftest.ts",
    "demo": "node scripts/create-demo-repo.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^24.3.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2"
  }
}
