{
  "name": "docxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multi-agent documentation-and-changelog pipeline built on the TrueForge agent harness.",
  "bin": {
    "docxy": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.11",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node dist/server/standalone.js",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "docxy": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/selftest.ts",
    "demo": "node scripts/create-demo-repo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backfill": "tsx scripts/backfill-postgres.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@neondatabase/serverless": "^1.1.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.80.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2"
  },
  "main": "dist/server/standalone.js",
  "packageManager": "npm@11.17.0"
}
