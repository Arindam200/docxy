# ---- Nebius Token Factory ---------------------------------------------------
# Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Defaults are fine; override only if you need a different region or provider name.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_PROVIDER_NAME=nebius

# Upstream model ids registered with the harness. Model ids move — run
# `docxy models` to see what your account can actually serve, then point
# these at real ids and re-run `docxy setup`.
# NEBIUS_MODEL_PRIMARY=deepseek-ai/DeepSeek-V4-Pro      # 1M ctx, structured outputs
# NEBIUS_MODEL_FAST=deepseek-ai/DeepSeek-V4-Flash       # cheaper sibling
# NEBIUS_MODEL_KIMI=moonshotai/Kimi-K3
# NEBIUS_MODEL_QWEN=Qwen/Qwen3.5-397B-A17B

# ---- TrueForge harness ------------------------------------------------------
# Start it with:  npx @truefoundry/trueforge@latest
# TRUEFORGE_BASE_URL=http://localhost:8790
# TRUEFORGE_TOKEN=            # only when OIDC is enabled
# TRUEFORGE_TIMEOUT_SECONDS=900

# ---- Which model each role uses --------------------------------------------
# Format: <provider-name>/<registered-model-name>
# Registered names are: deepseek-v4-pro, deepseek-v4-flash, kimi-k3, qwen3-5
# DOCXY_MODEL_COORDINATOR=nebius/deepseek-v4-pro
# DOCXY_MODEL_CHANGE_ANALYST=nebius/deepseek-v4-pro
# DOCXY_MODEL_IMPACT_MAPPER=nebius/deepseek-v4-pro
# DOCXY_MODEL_DOCS_UPDATER=nebius/deepseek-v4-pro
# DOCXY_MODEL_CHANGELOG_AUTHOR=nebius/deepseek-v4-flash

# ---- The repository being documented ----------------------------------------
# DOCXY_REPO_PATH=.
# DOCXY_DOCS_ROOTS=docs,README.md,doc,website/docs
# DOCXY_CHANGELOG=CHANGELOG.md
# DOCXY_STATE_DIR=.docxy

# Stable identity for the project being documented. Agent sessions and the symbol
# map are keyed on this. Defaults to GITHUB_REPOSITORY, then to the repo path.
# Set it explicitly anywhere the checkout is ephemeral (a CI runner, a hosted
# worker) — otherwise every run starts from cold sessions and an empty map.
# DOCXY_PROJECT_KEY=owner/repo

# Branch the documentation lives on. When set, docs are read from a throwaway
# worktree at that branch's tip and pull requests are opened against it — the
# code checkout is never touched. Leave unset to keep docs beside the code.
# The branch must already exist; docxy will not create it for you.
# DOCXY_DOCS_BRANCH=docs

# ---- Validation -------------------------------------------------------------
# DOCXY_VALIDATE=true
# DOCXY_CHECK_LINKS=true
# DOCXY_DOCS_BUILD_COMMAND=          # e.g. "npm run docs:build"
# DOCXY_TEST_COMMAND=                # e.g. "npm test"

# ---- Approval ---------------------------------------------------------------
# When a human must sign off BEFORE the pull request is opened.
#
#   auto      (default) never gate. The pull request opens as soon as the
#             proposal validates, and reviewing/merging it is the control.
#             Opening a pull request merges nothing.
#   elevated  gate only elevated scope: breaking changes, documented public API,
#             or a proposed major version bump.
#   always    gate every proposal, however routine.
# DOCXY_APPROVAL_MODE=auto

# Minutes before a pending request is reported stale. It is never auto-resolved.
# DOCXY_APPROVAL_STALE_MINUTES=60

# ---- Pull requests ----------------------------------------------------------
# GITHUB_TOKEN=                 # falls back to the gh CLI when unset
# DOCXY_BASE_BRANCH=main

# ---- Harness sandbox + git-backed skills (optional) -------------------------
# Off by default: skill packs are inlined into instructions instead, so no
# sandbox provider account is needed. Turning this on requires the skill packs to
# be registered as git-backed skills in the harness.
# DOCXY_USE_HARNESS_SKILLS=false

# DOCXY_PORT=4317
